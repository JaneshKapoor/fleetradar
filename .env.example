# Copy to `.env` and fill in. `.env` is gitignored — never commit real keys.

# --- Bright Data -----------------------------------------------------------
# API key from the Bright Data dashboard. Used by the Python SDK in
# backend/fleetradar/brightdata/ to trigger collector runs programmatically.
# The `bdata` CLI authenticates separately via `bdata login`.
BRIGHTDATA_API_KEY=

# NOTE: collector IDs are NOT here. Each watchlist source page has its own
# structure and therefore its own scraper, so the IDs live per-source in
# config/watchlist.json (`sources.changelog.collector_id` /
# `sources.eol.collector_id`). They are account-scoped identifiers, not secrets,
# and are committed so any team member can run the pipeline.

# --- Anthropic -------------------------------------------------------------
# Used only by the Type 1 (breaking change) classifier, which reads raw
# changelog text and returns structured JSON. EOL classification needs no LLM.
ANTHROPIC_API_KEY=

# --- Local storage ---------------------------------------------------------
# SQLite file the backend writes to. Relative paths resolve from the repo root.
FLEETRADAR_DB_PATH=data/fleetradar.db

# --- Agent -----------------------------------------------------------------
# Where the local agent POSTs its inventory. Each fleet host sets this.
FLEETRADAR_BACKEND_URL=http://localhost:8000
